<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/solicitacao_de_contratacao"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtMunicipio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/municipio"/>

        <EditText
            android:id="@+id/edtEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/estado"/>

        <EditText
            android:id="@+id/edtResponsavel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/responsavel"/>

        <EditText
            android:id="@+id/edtCargo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cargo"/>

        <EditText
            android:id="@+id/edtTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/telefone"
            android:inputType="phone"/>

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/e_mail"
            android:inputType="textEmailAddress"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/plano_desejado"
            android:textStyle="bold"/>

        <RadioGroup
            android:id="@+id/radioPlano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbIndividual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plano_individual"/>

            <RadioButton
                android:id="@+id/rbBasico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plano_basico"/>

            <RadioButton
                android:id="@+id/rbMunicipal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plano_municipal"/>
        </RadioGroup>

        <LinearLayout
            android:id="@+id/layoutExtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/txtAdmExtras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/administradores_extras"/>

            <EditText
                android:id="@+id/edtAdminsExtras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/quantidade"
                android:inputType="number"/>

            <TextView
                android:id="@+id/txtAgentesExtras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agentes_extras"/>

            <EditText
                android:id="@+id/edtAgentesExtras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/quantidade"
                android:inputType="number"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtValorEstimadoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/valor_mensal_estimado"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/txtValorEstimado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:text="@string/valor_estimado"
            android:textAlignment="center"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtResumoPlano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/edtObservacoes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:hint="@string/observacoes"
            android:inputType="textMultiLine"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <Button
            android:id="@+id/btnEnviarSolicitacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:text="@string/enviar_solicitacao"/>

        <Button
            android:id="@+id/btnSairEnviarSolicitacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:layout_marginTop="16dp"
            android:text="@string/sair"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>