<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".Denunciar">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tbDenuncias"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
    </FrameLayout>

    <ScrollView
        android:id="@+id/scrow_reclamacao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbDenuncias">

        <LinearLayout
            android:id="@+id/layout_reclamacao_edtText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/gridReclamacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:rowCount="2">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/imgCamReclamacao1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/camera"
                        android:contentDescription="@string/icone_camera_para_selecionar_imagem" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/imgCamReclamacao2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/camera"
                        android:contentDescription="@string/icone_camera_para_selecionar_imagem" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/imgCamReclamacao3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/camera"
                        android:contentDescription="@string/icone_camera_para_selecionar_imagem" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardElevation="4dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/video_container">

                        <VideoView
                            android:id="@+id/videoReclamacao"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:contentDescription="@string/icone_video_para_selecionar_video" />

                        <ImageView
                            android:id="@+id/thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/camera_video"
                            android:contentDescription="@string/icone_video_para_selecionar_video" />


                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>
            <!-- Campos de entrada -->
            <EditText
                android:id="@+id/edt_endereco_reclamacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Endereco"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                android:inputType="text"
                style="@style/EditTextStyle" />

            <EditText
                android:id="@+id/edt_numero_reclamacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/numero"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                android:inputType="number"
                style="@style/EditTextStyle" />

            <EditText
                android:id="@+id/edt_referencia_reclamacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/referencia"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                android:inputType="text"
                style="@style/EditTextStyle" />

            <EditText
                android:id="@+id/edt_reclamacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/reclamacao"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                android:inputType="textMultiLine"
                android:maxLines="5"
                style="@style/EditTextStyle" />

            <!-- Botões -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">
                <Button
                    android:id="@+id/btnEnviarReclamacao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:text="@string/enviar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/ButtonStyle" />

                <Button
                    android:id="@+id/btnCancelarReclamacao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:text="@string/cancelar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/ButtonStyle" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>