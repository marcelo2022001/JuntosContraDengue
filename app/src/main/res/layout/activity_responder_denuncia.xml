<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainVisualizarDenunciaUsuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ResponderDenunciaActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarVisualReclaUsuario"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="RESPONDER RECLAMAÇÕES"  />

    <ScrollView
        android:id="@+id/scrowResponderReclamacao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarVisualReclaUsuario">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrowResponderReclamacao">

        <androidx.cardview.widget.CardView
                android:id="@+id/card_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@drawable/button_style_custom"
                app:cardCornerRadius="7dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/resposta"
                        android:textColor="#090808"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/txtInputLayoutRespostaReclamacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:counterEnabled="true"
                        app:counterMaxLength="560"
                        app:errorEnabled="true"
                        app:errorTextAppearance="@style/ErrorText">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtInputEditRespostaReclamacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:padding="16dp"
                            android:paddingBottom="8dp"
                            android:text="@string/cuidados_sobre_escorpioes"
                            android:textColor="@color/black">
                        </com.google.android.material.textfield.TextInputEditText>

                    </com.google.android.material.textfield.TextInputLayout>


                </LinearLayout>
            <ProgressBar
                android:id="@+id/pbRespostaReclamacao"
                style="?android:attr/progressBarStyle"
                android:layout_marginHorizontal="16dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            </androidx.cardview.widget.CardView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_view_scrollUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:stateListAnimator="@drawable/button_style_custom"
                app:cardBackgroundColor="#EEF6F5"
                app:cardCornerRadius="7dp"
                app:cardElevation="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/adicionar_imagens_da_visita"
                    android:textColor="@color/black"
                    android:textStyle="bold">
                </TextView>

                <GridLayout
                    android:id="@+id/grdRespUsuarioImagens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="16dp"
                    android:rowCount="1">

                    <ImageView
                        android:id="@+id/image_1_responder_reclamacao"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        android:background="#EAEBEC"
                        android:src="@drawable/baseline_add"
                        android:contentDescription="@string/selecionar_uma_imagem">
                    </ImageView>

                    <ImageView
                        android:id="@+id/image_2_responder_reclamacao"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:background="#EAEBEC"
                        android:src="@drawable/baseline_add"
                        android:contentDescription="@string/adicionar_imagens_da_visita">
                    </ImageView>

                    <ImageView
                        android:id="@+id/image_3_responder_reclamacao"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:background="#EAEBEC"
                        android:src="@drawable/baseline_add"
                        android:contentDescription="@string/adicionar_imagens_da_visita">
                    </ImageView>

                    <ImageView
                        android:id="@+id/image_4_responder_reclamacao"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:background="#EAEBEC"
                        android:src="@drawable/baseline_add"
                        android:contentDescription="@string/adicionar_imagens_da_visita">
                    </ImageView>

                </GridLayout>

            </androidx.cardview.widget.CardView>

        </HorizontalScrollView>

            <Button
                android:id="@+id/btnResponderReclamacaoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/enviar">
            </Button>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
