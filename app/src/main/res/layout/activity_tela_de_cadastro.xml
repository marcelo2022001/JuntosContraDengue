<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCad"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TelaDeCadastro">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCad"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navigationIcon="@drawable/arrow_back"
        app:title="TELA DE CADASTRO"
        app:titleMarginStart="50dp">
    </androidx.appcompat.widget.Toolbar>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewCad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarCad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true">
        <ScrollView
            android:id="@+id/scrowViewCadastro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <EditText
                    android:id="@+id/edtNomeCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:hint="@string/nome_completo"
                    android:inputType="textAutoComplete"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtCpfCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="@string/cpf"
                    android:background="@drawable/border_rounded_gray"
                    android:hint="@string/cpf"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtTelefoneCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:hint="@string/telefone"
                    android:inputType="phone"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtEnderecoCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:hint="@string/endereco"
                    android:inputType="textAutoComplete"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtNumCasaCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:hint="@string/numero"
                    android:inputType="textAutoComplete"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtConjuntoCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:hint="@string/conjunto"
                    android:inputType="textAutoComplete"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtEmailCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="E-mail"
                    android:background="@drawable/border_rounded_gray"
                    android:hint="@string/e_mail"
                    android:inputType="textEmailAddress"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtConfirmeEmailCad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/border_rounded_gray"
                    android:clickable="false"
                    android:enabled="true"
                    android:hint="@string/confirme_seu_e_mail"
                    android:inputType="textEmailAddress"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtTextSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="Senha"
                    android:background="@drawable/border_rounded_gray"
                    android:drawableEnd="@drawable/eye_closed"
                    android:drawablePadding="8dp"
                    android:hint="@string/senha"
                    android:inputType="numberPassword"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <EditText
                    android:id="@+id/edtTextConfirmarSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="Senha"
                    android:background="@drawable/border_rounded_gray"
                    android:drawableEnd="@drawable/eye_closed"
                    android:drawablePadding="8dp"
                    android:hint="@string/confirme_sua_senha"
                    android:inputType="numberPassword"
                    android:minHeight="48dp"
                    android:padding="8dp">
                </EditText>

                <CheckBox
                    android:id="@+id/checkBoxCad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/eu_li_e_aceito_os_termos_de_uso"
                    android:textColor="#FF9800">
                </CheckBox>

                <TextView
                    android:id="@+id/ler_termos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ler_termos_de_uso"
                    android:textColor="@color/light_blue_900"
                    android:textSize="16sp"
                    android:textStyle="bold">
                </TextView>

                <Button
                    android:id="@+id/btnCriarConta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/border_rounded_gray"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="@string/criar_conta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                </Button>

            </LinearLayout>

        </ScrollView>

        <!-- Fragment container -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>