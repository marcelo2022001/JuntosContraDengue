<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView_reclamacoes_agentes"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="8dp"
    android:background="#AEABAF"
    app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="40"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_da_reclamacao"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="16dp">
                </TextView>

                <TextView
                    android:id="@+id/txt_dt_reclamacao"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/data_reclamacao_dd_mm_aaaa"
                    android:textColor="#101010"
                    android:textSize="16sp">
                </TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reclamacao"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="16dp">
                </TextView>

                <TextView
                    android:id="@+id/txt_titulo_reclamacao"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/reclamacao"
                    android:textColor="#101010"
                    android:textSize="16sp"
                    android:textStyle="italic">
                </TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reclamante"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="16dp">
                </TextView>

                <TextView
                    android:id="@+id/txt_reclamante"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/nome_reclamante"
                    android:textColor="#101010"
                    android:textSize="16sp"
                    android:textStyle="italic">
                </TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/telefone"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="16dp">
                </TextView>

                <TextView
                    android:id="@+id/txt_fone_reclamante"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/telefone"
                    android:textColor="#101010"
                    android:textSize="16sp"
                    android:textStyle="italic">
                </TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_da_reclamacao"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="16dp">
                </TextView>

                <TextView
                    android:id="@+id/txt_status_reclamacao"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/aguardando"
                    android:textColor="#101010"
                    android:textSize="16sp"
                    android:textStyle="italic">
                </TextView>

                <TextView
                    android:id="@+id/txtView_respondido_por"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/respondido_por"
                    android:visibility="gone"
                    android:textColor="@color/black"
                    android:textStyle="bold">
                </TextView>

                <TextView
                    android:id="@+id/txt_respondido_por"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    android:textColor="#101010"
                    android:textSize="16sp"
                    android:textStyle="italic">
                </TextView>

            </LinearLayout>

            <ImageView
                android:id="@+id/img_verificar_reclamacao"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:src="@drawable/seta_aberta_direita"
                app:tint="#1165B8">
            </ImageView>

        </LinearLayout>

</androidx.cardview.widget.CardView>
