<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardFullScreen"
        android:layout_width="393dp"
        android:layout_height="303dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp">

        <ProgressBar
            android:id="@+id/pBarFullScreen"
            android:layout_width="130dp"
            android:layout_height="86dp"
            android:layout_marginStart="100dp"
            android:layout_marginTop="100dp">
        </ProgressBar>

        <ImageView
            android:id="@+id/imgViewFullScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnSubsImgFullScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/border_rounded_gray"
        android:clickable="true"
        android:text="@string/substituir_imagem"
        android:textSize="12sp" />

</LinearLayout>
