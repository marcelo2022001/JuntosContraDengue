<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_identificacao"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DenunciaIdentificacaoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Texto principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/deseja_se_identificar"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Conteúdo principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Imagem -->
            <ImageView
                android:id="@+id/gifIdentificar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/identificacao_gif"
                android:layout_marginBottom="16dp" />

            <!-- Título benefícios -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Você poderá:"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp" />

            <!-- Lista de benefícios -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <CheckBox
                    android:id="@+id/check_acompanhar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:checked="true"
                    android:enabled="false"
                    android:text="@string/acompanhar_as_reclamacoes_feitas_e_verificar_a_solucao"
                    android:textColor="#0E0E0E"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_contato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:checked="true"
                    android:enabled="false"
                    android:text="@string/podemos_entrar_em_contato_caso_necessite"
                    android:textColor="#131313"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_avaliar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:checked="true"
                    android:enabled="false"
                    android:text="@string/avaliar_as_reclamacoes_feitas_resolvido_nao_resolvido"
                    android:textColor="#131313"
                    android:textSize="14sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarIdentificacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Botões -->

            <Button
                android:id="@+id/btnIdentificar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/quero_me_identificar"
                style="@style/ButtonStyle"/>

            <Button
                android:id="@+id/btnAnonimo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/quero_ficar_anonimo"
                style="@style/ButtonStyle" />

            <!-- Link -->
            <TextView
                android:id="@+id/TextViewLinkGIF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autoLink="web"
                android:gravity="center"
                android:text="@string/download_da_gif_em_https_www_flaticon_com"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>