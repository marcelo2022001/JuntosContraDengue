<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardAddSlider"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp">

        <ProgressBar
            android:id="@+id/pBarAddSlider"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="150dp"
            android:layout_marginTop="50dp">
        </ProgressBar>

        <ImageView
            android:id="@+id/imgViewAddSlider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnSubstituirImagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/border_rounded_gray"
        android:text="@string/substituir_imagem"
        android:textSize="12sp" />

</LinearLayout>
