<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView_reclamacoes_usuarios"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="8dp"
    android:background="#AEABAF"
    app:cardElevation="8dp">

    <LinearLayout
        android:id="@+id/lytReclamacoesUsers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/data_da_reclamacao"
                android:textColor="@color/black"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/txt_dt_reclamacaoUser"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/data_da_reclamacao"
                android:textColor="#101010"
                android:textSize="16sp">
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/reclamacao"
                android:textColor="@color/black"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/txt_titulo_reclamacaoUser"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/reclamacao"
                android:textColor="#101010"
                android:textSize="16sp"
                android:textStyle="italic">
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/local"
                android:textColor="@color/black"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/txt_local_reclamacaoUser"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/endereco"
                android:textColor="#101010"
                android:textSize="16sp"
                android:textStyle="italic">
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/status_da_reclamacao"
                android:textColor="@color/black"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/txt_status_reclamacaoUser"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/aguardando"
                android:textColor="#101010"
                android:textSize="16sp"
                android:textStyle="italic">
            </TextView>

            <TextView
                android:id="@+id/txt_respondidoPorViewUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/respondido_por"
                android:visibility="gone"
                android:textColor="@color/black"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/txt_respondido_por"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:textColor="#101010"
                android:textSize="16sp"
                android:textStyle="italic">
            </TextView>

        </LinearLayout>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/img_excluir_reclamacaoUser"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:src="@drawable/baseline_delete"
            app:tint="#1165B8">
        </ImageView>

    </LinearLayout>

        <ImageView
            android:id="@+id/img_verificar_reclamacaoUser"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:src="@drawable/seta_aberta_direita"
            app:tint="#1165B8">
        </ImageView>

    </LinearLayout>

</androidx.cardview.widget.CardView>
